# Browser (Vite) — public values, safe to expose
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_CLERK_PRODUCTION_PUBLISHABLE_KEY=pk_live_...
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server (api/ functions) — SECRET. Set these in Vercel's Environment Variables,
# and locally in .env.local (git-ignored). Never put them in the committed .env.
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
# A domain you own; kiosk accounts get addresses like kiosk+org_xxx@<domain> that never receive mail.
KIOSK_EMAIL_DOMAIN=wefamplan.com
